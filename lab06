def count_by_extension(paths: list[str]) -> dict[str, int]:
    
    #Считает количество файлов для каждого расширения.
    #Расширение в нижнем регистре, без точки.
    
    result = {}
    for path in paths:
        # Разделяем путь по последней точке
        parts = path.split('.')
        if len(parts) > 1:
            # Берем последнюю часть после точки и приводим к нижнему регистру
            ext = parts[-1].lower()
        else:
            # Если точки нет, расширение пустое
            ext = ""
        
        # Увеличиваем счетчик для найденного расширения
        result[ext] = result.get(ext, 0) + 1
        
    return result


def deepest_path(paths: list[str]) -> str:
    
    #возвращает путь с наибольшей вложенностью.
    #При равенстве — первый по алфавиту.
    
    if not paths:
        return ""
    
    # Сортируем пути по алфавиту (чтобы при равенстве вложенности брался первый)
    # Затем ищем максимум по количеству разделителей '/'
    # Функция sorted гарантирует, что при равном количестве слэшей,
    # первым будет тот, который идет раньше по алфавиту.
    return max(sorted(paths), key=lambda p: p.count('/'))


def human_size(n_bytes: int) -> str:
    
    #Переводит размер из байт в удобные единицы: Б, КБ, МБ, ГБ, ТБ.
    
    if n_bytes < 1024:
        return f"{n_bytes} Б"
    
    units = ["КБ", "МБ", "ГБ", "ТБ"]
    size = float(n_bytes)
    
    for unit in units:
        size /= 1024.0
        if size < 1024.0:
            # Округляем до 1 знака после запятой
            # Использование :.1f автоматически сделает округление (например 1.55 -> 1.6)
            return f"{size:.1f} {unit}"
            
    # Если размер больше ТБ (крайний случай, который по условию не должен часто встречаться, 
    # но для надежности можно вернуть последний посчитанный)
    return f"{size:.1f} ТБ"
